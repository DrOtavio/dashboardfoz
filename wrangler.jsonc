{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "foz-finance",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {"binding":"DB","database_name":"foz-finance","database_id":"COLOQUE_AQUI_ID_DO_D1"}
  ]
}
